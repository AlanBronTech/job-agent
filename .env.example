# --- API keys -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=                       # only needed if a route below uses gemini

# --- Per-call-type model routing ------------------------------------------
# All model calls go through adapters/llm.py. Provider + model are selected
# per call type. Format: "provider:model" (provider is "anthropic" or "gemini").
#
# Resolution order for a given call type:
#   1. the LLM_<CALLTYPE> var below, if set
#   2. LLM_DEFAULT, if set
#   3. the legacy ANTHROPIC_MODEL / ANTHROPIC_TRIAGE_MODEL fallback (anthropic)
#
# Leave any of these unset to fall through to the next step.
LLM_DEFAULT=anthropic:claude-sonnet-4-6
LLM_TRIAGE=anthropic:claude-haiku-4-5-20251001
# LLM_PARSE=anthropic:claude-sonnet-4-6
# LLM_SCORE=anthropic:claude-sonnet-4-6
# LLM_GENERATE=anthropic:claude-sonnet-4-6
# LLM_PREP=gemini:gemini-2.5-flash

# Legacy fallbacks (still honoured when the LLM_* routes above are unset).
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TRIAGE_MODEL=claude-haiku-4-5-20251001

# Per-call cost/token log for the eval harness (JSONL, one line per LLM call).
RUNS_LOG_PATH=runs.jsonl

# Where generated documents are written, one folder per application. Google
# Drive upload was dropped on 2026-09-01 — copy from here when it suits you.
OUTPUT_DIR=~/job-agent-out

# Budget mode: route every model call to a free-tier model, overriding the
# LLM_* routing above. `jobagent --budget <command>` does the same for one
# command without editing this file. The answers are worse — `jobagent eval
# diff` measures by how much against the recorded outcomes.
BUDGET_MODE=false
BUDGET_MODEL=gemini:gemini-2.5-flash

DB_PATH=~/.job-agent/jobagent.db
PROFILE_DIR=~/.job-agent/profile

GMAIL_ALERT_QUERIES=from:jobmail@seek.com.au;from:jobs-listings@linkedin.com
POLL_LOOKBACK_HOURS=14
